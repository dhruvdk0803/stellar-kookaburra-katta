# Copy this file to `.phonepe.env` (same folder) and fill in the real values.
# `.phonepe.env` is gitignored and is deleted automatically after setup runs.
#
# Do NOT paste these values into chat. Just fill the file and say "done".

# --- Supabase ---------------------------------------------------------------
# Generate at: https://supabase.com/dashboard/account/tokens
# Click "Generate new token", name it anything (e.g. "cli"), copy it once.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- PhonePe (PG V2 / Standard Checkout) ------------------------------------
# From https://business.phonepe.com -> Developer Settings -> API Keys.
# You need client_id, client_secret, client_version.
# If that page shows only "Salt Key" / "Salt Index", those are the dead V1 keys:
# open Help in the dashboard and ask support to move you to PG V2 keys.
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1

# SANDBOX or PRODUCTION.
# Note: PhonePe's Developer Settings page only shows PRODUCTION credentials.
# Sandbox/UAT credentials must be requested from PhonePe support separately.
# If you only have production keys, set this to PRODUCTION.
PHONEPE_ENV=PRODUCTION

# Your live site origin, no trailing slash. Used as the fallback for the
# post-payment redirect when the browser doesn't send an Origin header.
APP_BASE_URL=https://your-domain.com
