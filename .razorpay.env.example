# Copy this file to `.razorpay.env` (same folder) and fill in the real values.
# `.razorpay.env` is gitignored and is deleted automatically after setup runs.
#
# Do NOT paste these values into chat. Just fill the file and say "done".

# --- Supabase ---------------------------------------------------------------
# Generate at: https://supabase.com/dashboard/account/tokens
# Click "Generate new token", name it anything (e.g. "cli"), copy it once.
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Razorpay ---------------------------------------------------------------
# From https://dashboard.razorpay.com -> Settings -> API Keys.
# Test mode keys are prefixed "rzp_test_"; live keys are "rzp_live_".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Choose a long random value, then use the exact same value as the Webhook
# Secret in Razorpay Dashboard when creating the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=
